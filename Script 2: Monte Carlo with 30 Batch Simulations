def generate_figure_agent_14_behavioral_panel(mc_history_dict, target_id=14): 

    print(f"\nGenerating Figure A: Agent {target_id} Behavioral Evolution (2015–2036)...") 

    years = list(range(2015, 2037)) 

    data_by_year = {yr: {"compliance": [], "detection": [], "eu": []} for yr in years} 

     

    for seed, history in mc_history_dict.items(): 

        for rec in history: 

            if rec.get("month", 12) == 12:  

                yr = rec["year"] 

                if yr in years: 

                    match = next((a for a in rec["agent_states"] if a["id"] == target_id), None) 

                    if match: 

                        is_comp = match.get("true_compliance", 1.0) 

                        data_by_year[yr]["compliance"].append(is_comp) 

                        data_by_year[yr]["detection"].append(match.get("omega", 0.0)) 

                        data_by_year[yr]["eu"].append(match.get("financial_reserves", 50000.0)) 

  

    plot_years, comp_mean, comp_lower, comp_upper = [], [], [], [] 

    det_mean, det_lower, det_upper = [], [], [] 

    eu_mean, eu_lower, eu_upper = [], [], [] 

  

    for yr in years: 

        c_vals = data_by_year[yr]["compliance"] 

        d_vals = data_by_year[yr]["detection"] 

        e_vals = data_by_year[yr]["eu"] 

         

        if c_vals: 

            plot_years.append(yr) 

            cm, cs = np.mean(c_vals), np.std(c_vals) 

            comp_mean.append(cm); comp_lower.append(max(0.0, cm - cs)); comp_upper.append(min(1.0, cm + cs)) 

             

            dm, ds = np.mean(d_vals), np.std(d_vals) 

            det_mean.append(dm); det_lower.append(max(0.0, dm - ds)); det_upper.append(dm + ds) 

             

            em, es = np.mean(e_vals), np.std(e_vals) 

            eu_mean.append(em); eu_lower.append(em - es); eu_upper.append(em + es) 

  

    if not plot_years: return 

  

    fig, axes = plt.subplots(3, 1, figsize=(10, 11), sharex=True) 

     

    axes[0].plot(plot_years, comp_mean, color="#1f77b4", linewidth=2.5, label="Mean Compliance Probability") 

    axes[0].fill_between(plot_years, comp_lower, comp_upper, color="#1f77b4", alpha=0.2, label=f"± 1 SD Envelope ({TOTAL_SEEDS} Seeds)") 

    axes[0].axvline(x=2026, color="black", linestyle="--", linewidth=1.5, label="DWT Policy Shock (2026)") 

    axes[0].set_ylabel("Pr(Compliance)", fontweight="bold") 

    axes[0].set_title(f"Agent {target_id}'s Behavioural Model Evolution (Aggregated across {TOTAL_SEEDS} Seeds)", fontsize=13, fontweight="bold", pad=10) 

    axes[0].set_ylim(-0.05, 1.05) 

    axes[0].legend(loc="lower left", frameon=True, fontsize=10) 

     

    axes[1].plot(plot_years, det_mean, color="#d62728", linewidth=2.5, label="Mean Pollution Trace (ω)") 

    axes[1].fill_between(plot_years, det_lower, det_upper, color="#d62728", alpha=0.2, label="± 1 SD Envelope") 

    axes[1].axvline(x=2026, color="black", linestyle="--", linewidth=1.5) 

    axes[1].set_ylabel("Trace Intensity (ω)", fontweight="bold") 

    axes[1].legend(loc="upper left", frameon=True, fontsize=10) 

     

    axes[2].plot(plot_years, eu_mean, color="#2ca02c", linewidth=2.5, label="Mean Financial Buffer / EU (£)") 

    axes[2].fill_between(plot_years, eu_lower, eu_upper, color="#2ca02c", alpha=0.2, label="± 1 SD Envelope") 

    axes[2].axvline(x=2026, color="black", linestyle="--", linewidth=1.5, label="DWT Mandate") 

    axes[2].set_ylabel("Reserves / EU (£)", fontweight="bold") 

    axes[2].set_xlabel("Simulation Year (2015–2036)", fontweight="bold") 

    axes[2].legend(loc="upper left", frameon=True, fontsize=10) 

  

    for ax in axes: 

        ax.grid(True, linestyle=":", alpha=0.7) 

        ax.set_xlim(2015, 2036) 

        ax.set_xticks(range(2015, 2037, 2)) 

  

    sns.despine() 

    plt.tight_layout() 

    output_filename = os.path.join(os.path.expanduser("~"), "Desktop", f"Figure_Agent_{target_id}_Behavioral_Model_Aggregated.png") 

    plt.savefig(output_filename, dpi=300, bbox_inches="tight") 

    print(f"[SUCCESS] Timeline figure saved to: {output_filename}") 

  

  

