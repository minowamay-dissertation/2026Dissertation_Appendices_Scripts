class WasteComplianceEngine: 

    def __init__(self, simulation_year=2015): 

        self.current_year = simulation_year 

        self.ccs_master_records = ccs_master_records 

        self.regions = ["North", "Midlands", "South_West_Thames", "East_South_East"] 

  

        self.region_geoms = { 

            "North": Polygon([(-3.2, 53.3), (-3.2, 55.9), (-1.2, 55.9), (-0.2, 54.2), (-0.8, 53.3)]), 

            "Midlands": Polygon([(-3.0, 52.0), (-3.0, 53.3), (-0.8, 53.3), (0.4, 52.8), (0.4, 52.0), (-1.8, 51.3)]), 

            "East_South_East": Polygon([(0.4, 50.7), (0.4, 52.8), (1.8, 52.8), (1.8, 51.0), (1.1, 50.5), (0.4, 50.7)]), 

            "South_West_Thames": Polygon([(-5.7, 50.0), (-5.2, 51.3), (-3.0, 52.0), (-1.8, 51.3), (0.4, 50.7), (-0.8, 50.2)]) 

        } 

        self.ea_regions_gdf = gpd.GeoDataFrame([{"Region": r, "geometry": g} for r, g in self.region_geoms.items()], crs="EPSG:4326") 

         

        projected_gdf = self.ea_regions_gdf.to_crs("EPSG:27700") 

        self.region_coordinates = {row["Region"]: (row["geometry"].centroid.x, row["geometry"].centroid.y) for _, row in projected_gdf.iterrows()} 

         

        self.distance_matrix = {} 

        for r1 in self.regions: 

            self.distance_matrix[r1] = {} 

            c1 = self.region_coordinates.get(r1, (0, 0)) 

            for r2 in self.regions: 

                c2 = self.region_coordinates.get(r2, (0, 0)) 

                dist = math.sqrt((c1[0] - c2[0])**2 + (c1[1] - c2[1])**2) 

                self.distance_matrix[r1][r2] = max(5.0, dist) 

  

        self.facility_matrix = { 

            "Landfill": {"R_i": 500.0, "T_i": float('inf')}, 

            "Transfer": {"R_i": 200.0, "T_i": 75000.0}, 

            "Treatment": {"R_i": 75.0, "T_i": 75000.0}, 

            "MRS": {"R_i": 150.0, "T_i": 25000.0}, 

            "Incineration": {"R_i": 72.0, "T_i": 200000.0} 

        } 

  

        self.historical_tax_rates = { 

            2015: {'std': 82.60, 'inert': 2.60}, 2016: {'std': 84.40, 'inert': 2.65}, 

            2017: {'std': 86.10, 'inert': 2.70}, 2018: {'std': 88.95, 'inert': 2.80}, 

            2019: {'std': 91.35, 'inert': 2.90}, 2020: {'std': 94.15, 'inert': 3.00}, 

            2021: {'std': 96.70, 'inert': 3.10}, 2022: {'std': 98.60, 'inert': 3.15}, 

            2023: {'std': 102.10, 'inert': 3.25}, 2024: {'std': 103.70, 'inert': 3.30}, 

            2025: {'std': 106.50, 'inert': 3.40}, 2026: {'std': 110.00, 'inert': 3.50}, 

        } 

        for y in range(2027, 2037): 

            self.historical_tax_rates[y] = { 

                'std': self.historical_tax_rates[y-1]['std'] + 3.00, 

                'inert': self.historical_tax_rates[y-1]['inert'] + 0.10 

            } 

  

    def assign_ea_region(self, pos): 

        if pos is None: return "Midlands" 

        point = Point(pos) 

        for _, row in self.ea_regions_gdf.iterrows(): 

            if point.within(row["geometry"]): return row["Region"] 

        return min(self.region_coordinates.keys(), key=lambda r: Point(pos).distance(Point(self.region_coordinates[r]))) 

  

    def get_tax_rates(self, year): 

        safe_year = min(max(year, 2015), 2036) 

        return self.historical_tax_rates[safe_year]["std"], self.historical_tax_rates[safe_year]["inert"] 

  

    def step_environmental_physics(self, facility_nodes): 

        for node in facility_nodes: 

            if getattr(node, 'is_bankrupt', False): continue 

            if getattr(node, 'facility_type', None) in ["Treatment", "MRS"]: 

                if not getattr(node, 'is_stabilized', True) and getattr(node, 'untreated_inventory', 0.0) > 0: 

                    if not hasattr(node, 'pollution_trace_omega'): node.pollution_trace_omega = 0.0 

                    node.pollution_trace_omega += (node.untreated_inventory * 0.002) 

                    node.dynamic_detection_probability = min(1.0, 0.05 + (0.1 * node.pollution_trace_omega)) 

                else: 

                    if hasattr(node, 'pollution_trace_omega'): node.pollution_trace_omega = max(0.0, node.pollution_trace_omega - 0.05) 

                    node.dynamic_detection_probability = 0.05 

  

    def execute_treatment_arbitrage_state(self, node, volume_v, c_trt, h_raw=1.0, h_legal=0.1, is_arbitrage=False): 

        if is_arbitrage: 

            if not hasattr(node, 'untreated_inventory'): node.untreated_inventory = 0.0 

            node.untreated_inventory += volume_v 

            node.is_stabilized = False 

            node.hazard_intensity = h_raw 

            return volume_v * c_trt, False 

        else: 

            node.is_stabilized = True 

            node.hazard_intensity = h_legal 

            if hasattr(node, 'untreated_inventory'): node.untreated_inventory = max(0.0, node.untreated_inventory - volume_v) 

            return -(volume_v * c_trt), True 

  

    def calculate_remediation_penalty(self, volume_v, c_trt, beta_clean=2.0): 

        return volume_v * (c_trt * beta_clean) 

  

  

class SpatialOperatorAgent(Agent): 

    def __init__(self, unique_id, model, lat_long=None, facility_type="Transfer", initial_rating="A", tier="small", cost_pressure=0.5): 

        super().__init__(model) 

        self.unique_id = unique_id 

        self.lat_long = lat_long 

        self.region = self.model.engine.assign_ea_region(lat_long) 

        self.facility_type = facility_type 

        self.tier = tier 

        self.cost_pressure = cost_pressure 

  

        matrix_specs = self.model.engine.facility_matrix.get(facility_type, {"R_i": 200.0, "T_i": 75000.0}) 

        self.max_storage_s_i = 50000.0 

        self.current_inventory_i_it = 0.0 

        self.daily_processing_rate_r_i = matrix_specs["R_i"] 

        self.financial_reserves = model.random.uniform(20000.0, 80000.0) 

        self.baseline_operational_cost = 14000.0 

        self.rating = initial_rating 

        self.is_bankrupt = False 

        self.historical_breaches = 0 

        self.risk_tolerance = np.random.beta(2, 4) 

        self.perceived_impunity = 0.0 

        self.preferred_target_region = self.region 

  

        self.is_tax_arbitrage = initial_rating in ["C", "D", "E", "F"] 

        self.is_treatment_arbitrage = initial_rating in ["D", "E", "F"] and facility_type in ["Treatment", "MRS"] 

        self.is_capacity_arbitrage = False 

        self.is_stabilized = initial_rating in ["A", "B", "C"] 

        self.true_compliance = 1.0 if initial_rating in ["A", "B"] else 0.0 

  

        self.time_since_last_inspection = random.randint(0, 24) 

        self.uncertainty_sigma = min(1.0, self.time_since_last_inspection * 0.05) 

        self.has_active_enforcement_notice = False 

        self.enforcement_countdown = 0 

        self.community_complaint_active = False 

  

        if not self.is_stabilized and facility_type in ["Treatment", "MRS"]: 

            self.untreated_inventory = 1000.0 

            self.pollution_trace_omega = 2.0 

        else: 

            self.pollution_trace_omega = 0.0 

  

    def evaluate_peer_pressure(self): 

        if not self.pos: return 0.0 

        neighbors = self.model.grid.get_neighbors(self.pos, moore=True, include_center=False, radius=3) 

        peer_agents = [a for a in neighbors if isinstance(a, SpatialOperatorAgent) and not a.is_bankrupt] 

        if not peer_agents: return 0.0 

        arbitrage_count = sum(1 for p in peer_agents if p.is_tax_arbitrage or p.is_treatment_arbitrage or p.is_capacity_arbitrage) 

        return arbitrage_count / len(peer_agents) 

  

    def evaluate_spatial_crime_displacement(self): 

        regional_heatmaps = getattr(self.model, 'regional_enforcement_pressure', {r: 0.1 for r in self.model.engine.regions}) 

        distance_lookup = self.model.engine.distance_matrix[self.region] 

        region_scores = {} 

        for r in self.model.engine.regions: 

            pressure = regional_heatmaps.get(r, 0.1) 

            dist_friction = distance_lookup.get(r, 10.0) 

            impedance = math.exp(min(700.0, 0.05 * dist_friction)) 

            region_scores[r] = max(0.001, 1.0 / (pressure * impedance)) 

        total = sum(region_scores.values()) 

        self.preferred_target_region = np.random.choice(self.model.engine.regions, p=[region_scores[r]/total for r in self.model.engine.regions]) 

  

    def update_behavioral_complexities(self, current_year): 

        if self.is_bankrupt: return 

        peer_ratio = self.evaluate_peer_pressure() 

        burn_rate = max(1.0, self.baseline_operational_cost) 

        cash_runway_months = self.financial_reserves / burn_rate 

        desperation = 2.5 if cash_runway_months < 3.0 else 1.0 

  

        if self.model.regional_enforcement_pressure.get(self.region, 0.1) > 0.4 and self.tier == "large" and random.random() < 0.7: 

            self.is_tax_arbitrage = self.is_treatment_arbitrage = self.is_capacity_arbitrage = False 

            self.true_compliance = 1.0 

            self.is_stabilized = True 

        else: 

            base_prob = max(0.05, (0.20 + (self.cost_pressure * 0.3)) - ((1-peer_ratio) * 0.35)) 

            comp_prob = min(1.0, (base_prob + (peer_ratio * 0.4)) * desperation) 

            if current_year >= 2026: comp_prob *= 0.70 

  

            if random.random() < comp_prob: 

                self.true_compliance = 0.0 

                self.is_tax_arbitrage = True 

                self.is_stabilized = False 

                if self.facility_type in ["Treatment", "MRS"]: self.is_treatment_arbitrage = True 

            else: 

                self.true_compliance = 1.0 

                self.is_tax_arbitrage = self.is_treatment_arbitrage = self.is_capacity_arbitrage = False 

                self.is_stabilized = True 

  

    def update_annual_compliance_with_contagion(self, current_year, all_operators): 

        if current_year <= 2024: 

            yr_record = self.model.engine.ccs_master_records.get(current_year, self.model.engine.ccs_master_records[2024]) 

            raw_historical = np.array(yr_record["pcts"], dtype=float) 

            historical_probs = raw_historical / raw_historical.sum() 

            self.rating = np.random.choice(["A", "B", "C", "D", "E", "F"], p=historical_probs) 

            if self.rating in ["A", "B"]: 

                self.true_compliance = 1.0; self.is_stabilized = True 

                self.is_tax_arbitrage = self.is_treatment_arbitrage = self.is_capacity_arbitrage = False 

            else: 

                self.true_compliance = 0.0; self.is_stabilized = False 

                self.is_tax_arbitrage = True 

                self.is_treatment_arbitrage = (self.facility_type in ["Treatment", "MRS"]) 

        else: 

            self.update_behavioral_complexities(current_year) 

            self.rating = random.choice(["A", "B"]) if self.true_compliance == 1.0 else random.choice(["C", "D", "F"]) 

  

    def process_incoming_consignment(self, volume_v): 

        if self.is_bankrupt: return 

        self.perceived_impunity = self.evaluate_peer_pressure() 

        self.evaluate_spatial_crime_displacement() 

  

        stress = max(1.0, 4.0 / max(0.1, self.financial_reserves / max(1.0, self.baseline_operational_cost))) 

        effective_risk = self.risk_tolerance * stress 

  

        std_tax, inert_tax = self.model.engine.get_tax_rates(self.model.current_year) 

        eu_tax = (volume_v * (std_tax - inert_tax)) - (max(0.01, getattr(self, 'dynamic_detection_probability', 0.05) - (self.perceived_impunity * 0.1)) * (volume_v * std_tax * 1.5)) 

  

        raw_tax = (eu_tax > 0) and (effective_risk + (self.perceived_impunity * 0.3) > 0.3) 

        self.is_tax_arbitrage = ((1 - 0.2) * (1.0 if getattr(self, 'is_tax_arbitrage', False) else 0.0) + 0.2 * (1.0 if raw_tax else 0.0)) >= 0.5 

         

        if self.is_tax_arbitrage: self.financial_reserves += (volume_v * (std_tax - inert_tax)) 

  

        if self.facility_type in ["Treatment", "MRS"]: 

            eu_treat = (volume_v * 50.0) - (max(0.01, getattr(self, 'dynamic_detection_probability', 0.05) - (self.perceived_impunity * 0.1)) * (volume_v * 100.0)) 

            raw_treat = (eu_treat > 0) and (effective_risk + (self.perceived_impunity * 0.3) > 0.35) 

            self.is_treatment_arbitrage = ((1 - 0.2) * (1.0 if getattr(self, 'is_treatment_arbitrage', False) else 0.0) + 0.2 * (1.0 if raw_treat else 0.0)) >= 0.5 

            fin_delta, _ = self.model.engine.execute_treatment_arbitrage_state(self, volume_v, 50.0, is_arbitrage=self.is_treatment_arbitrage) 

            self.financial_reserves += fin_delta 

  

        self.current_inventory_i_it += volume_v 

        if self.current_inventory_i_it > self.max_storage_s_i: 

            self.financial_reserves -= (self.current_inventory_i_it - self.max_storage_s_i) * 45.0   

            self.current_inventory_i_it = self.max_storage_s_i   

            self.is_capacity_arbitrage = True 

        else: self.is_capacity_arbitrage = False 

  

    def step(self): 

        if self.is_bankrupt: return 

        self.time_since_last_inspection += 1 

        self.uncertainty_sigma = min(1.0, self.uncertainty_sigma + 0.05)  

        if self.time_since_last_inspection >= 12 and not self.has_active_enforcement_notice and self.rating in ["C", "D", "E"]: 

            self.rating = "B"  

        self.community_complaint_active = True if (self.is_capacity_arbitrage or self.pollution_trace_omega > 1.0) and random.random() < 0.30 else False 

        self.financial_reserves += (self.model.random.uniform(14500.0, 23000.0) - self.baseline_operational_cost) 

        if self.financial_reserves <= 0: 

            self.is_bankrupt = True 

            self.rating = "F" 

  

  

