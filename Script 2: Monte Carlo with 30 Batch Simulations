class EAInspectorRLAgent(Agent): 

    def __init__(self, unique_id, model): 

        super().__init__(model) 

        self.unique_id = unique_id 

        self.q_table = np.zeros((3, 2, 2, 4, 16)) 

        self.alpha, self.gamma, self.epsilon = 0.20, 0.95, 0.20 

        self.last_state = (0, 0, 0, 0) 

        self.last_action = 0 

         

        self.phase1_audits = 0 

        self.phase1_caught = 0 

        self.phase2_audits = 0 

        self.phase2_caught = 0 

         

        # Proper per-tactic counts (audits vs caught) 

        self.tactic_audits = {0: 0, 1: 0, 2: 0, 3: 0} 

        self.tactic_caught = {0: 0, 1: 0, 2: 0, 3: 0} 

  

    def get_state(self): 

        active_ops = [a for a in self.model.agents if isinstance(a, SpatialOperatorAgent) and not a.is_bankrupt] 

        r_counts = {r: 0 for r in self.model.engine.regions} 

        r_omega = {r: 0 for r in self.model.engine.regions} 

        for op in active_ops: 

            if getattr(op, 'true_compliance', 1.0) == 0.0 or op.is_tax_arbitrage or op.is_treatment_arbitrage or op.is_capacity_arbitrage: 

                r_counts[op.region] += 1 

                if getattr(op, 'pollution_trace_omega', 0.0) > 3.0: r_omega[op.region] += 1 

        highest = max(r_counts, key=r_counts.get) 

        return (0 if r_counts[highest] < 200 else (1 if r_counts[highest] < 600 else 2),  

                1 if r_omega[highest] > 50 else 0, 1 if self.model.current_year >= 2026 else 0,  

                self.model.engine.regions.index(highest)) 

  

    def execute_inspections(self, active_ops): 

        is_phase_1 = (self.model.current_year <= 2024) 

        dynamic_rate = max(0.01, min(0.04, self.epsilon)) 

        self.last_state = self.get_state() 

        self.last_action = random.randint(0, 15) if is_phase_1 or random.random() < self.epsilon else int(np.argmax(self.q_table[self.last_state])) 

  

        reg_idx = self.last_action // 4 

        sub_policy = self.last_action % 4 

        focus_reg = self.model.engine.regions[reg_idx] 

  

        for op in active_ops: 

            if getattr(op, 'has_active_enforcement_notice', False): 

                op.enforcement_countdown -= 1 

                if op.enforcement_countdown <= 0: op.has_active_enforcement_notice = False  

        # ================================================================= 

        # REFINED TACTICAL RULES 

        # ================================================================= 

        is_remote = False 

        if is_phase_1: 

            sorted_ops = sorted([o for o in active_ops if o.region == focus_reg], key=lambda o: random.random()) 

        else: 

            if sub_policy == 0: 

                target_pool = [o for o in active_ops if o.region == focus_reg and getattr(o, 'has_active_enforcement_notice', False)] 

                sorted_ops = sorted(target_pool if target_pool else [o for o in active_ops if o.region == focus_reg], key=lambda o: getattr(o, 'pollution_trace_omega', 0.0), reverse=True) 

            elif sub_policy == 1: 

                large_rogues = [o for o in active_ops if o.region == focus_reg and (o.tier == "large" or o.cost_pressure > 0.6) and (not o.is_stabilized or o.is_tax_arbitrage)] 

                network_targets = set() 

                for hub in large_rogues: 

                    if hub.pos: 

                        neighbors = self.model.grid.get_neighbors(hub.pos, moore=True, include_center=False, radius=4) 

                        for n in neighbors: 

                            if isinstance(n, SpatialOperatorAgent) and n.region == focus_reg and n.tier in ["small", "medium"] and not n.is_bankrupt: 

                                network_targets.add(n) 

                target_pool = list(network_targets) + large_rogues 

                if not target_pool: target_pool = [o for o in active_ops if o.region == focus_reg] 

                sorted_ops = sorted(target_pool, key=lambda o: getattr(o, 'cost_pressure', 0.5), reverse=True) 

            elif sub_policy == 2: 

                target_pool = [o for o in active_ops if o.region == focus_reg and (getattr(o, 'pollution_trace_omega', 0.0) > 0.5 or getattr(o, 'community_complaint_active', False))] 

                sorted_ops = sorted(target_pool if target_pool else [o for o in active_ops if o.region == focus_reg], key=lambda o: getattr(o, 'pollution_trace_omega', 0.0), reverse=True) 

            else: 

                is_remote = True 

                sorted_ops = sorted([o for o in active_ops if o.region == focus_reg], key=lambda o: random.random()) 

  

        remote_batch = int(max(1, len([o for o in active_ops if o.region == focus_reg]) * 0.10)) 

        physical_batch = int(max(1, len([o for o in active_ops if o.region == focus_reg]) * dynamic_rate)) 

        sample = sorted_ops[:(remote_batch if is_remote else min(physical_batch, len(sorted_ops)))] 

  

        # Increment audit denominators correctly (per inspected agent in sample) 

        sample_size = len(sample) 

        if sample_size > 0: 

            if is_phase_1: 

                self.phase1_audits += sample_size 

            else: 

                if is_remote: 

                    self.tactic_audits[3] += sample_size 

                else: 

                    self.phase2_audits += sample_size 

                    self.tactic_audits[sub_policy] += sample_size 

  

        caught = 0 

        for agent in sample: 

            agent.time_since_last_inspection = 0 

            agent.uncertainty_sigma = 0.0 

            agent.community_complaint_active = False 

            is_rogue = agent.is_tax_arbitrage or agent.is_capacity_arbitrage or agent.is_treatment_arbitrage or not agent.is_stabilized 

  

            if is_remote: 

                if is_rogue and not is_phase_1 and random.random() < 0.75: 

                    caught += 1 

                    self.phase2_caught += 1 

                    self.tactic_caught[3] += 1 

                    agent.historical_breaches += 1 

                    agent.has_active_enforcement_notice = True 

                    agent.enforcement_countdown = 3 

                    agent.financial_reserves -= self.model.engine.calculate_remediation_penalty(40.0, 15.0) 

            else: 

                if is_phase_1: 

                    if is_rogue: 

                        caught += 1 

                        self.phase1_caught += 1 

                else: 

                    if is_rogue: 

                        caught += 1 

                        self.phase2_caught += 1 

                        self.tactic_caught[sub_policy] += 1 

  

                if agent.has_active_enforcement_notice: agent.has_active_enforcement_notice = False  

                if is_rogue: 

                    agent.historical_breaches += 1 

                    agent.has_active_enforcement_notice = True 

                    agent.enforcement_countdown = 3  

                    fine = self.model.engine.calculate_remediation_penalty(80.0, 30.0) * math.pow(1.6, agent.historical_breaches - 1) 

                    agent.financial_reserves -= fine 

                    agent.rating = {"F": "E", "E": "D", "D": "C", "C": "B", "B": "A", "A": "A"}.get(agent.rating, "B") 

                    if agent.rating in ["A", "B"]: 

                        agent.is_tax_arbitrage = agent.is_treatment_arbitrage = agent.is_capacity_arbitrage = False 

                        agent.is_stabilized = True 

                        agent.true_compliance = 1.0 

  

        for r in self.model.engine.regions: 

            self.model.regional_enforcement_pressure[r] = max(0.05, sum(1 for a in sample if a.region == r) / max(1, len(sample))) 

  

        if not is_phase_1: 

            rwd = (caught * 5000.0) + ((caught / max(1, sample_size) if not is_remote else 0.0) * 100000.0) - ((sample_size - caught) * 2000.0) 

            self.q_table[self.last_state + (self.last_action,)] += self.alpha * (rwd + self.gamma * np.max(self.q_table[self.get_state()]) - self.q_table[self.last_state + (self.last_action,)]) 

  

  

class SpatialWasteMarketModel(Model): 

    def __init__(self, width=150, height=150, start_year=2015, seed=42): 

        super().__init__() 

        random.seed(seed) 

        np.random.seed(seed) 

        self.grid = MultiGrid(width, height, torus=True) 

        self.current_year = start_year 

        self.current_month = 1 

        self.engine = WasteComplianceEngine(simulation_year=start_year) 

        self.regional_enforcement_pressure = {r: 0.1 for r in self.engine.regions} 

        self.inspector_agent = EAInspectorRLAgent(unique_id=9999, model=self) 

         

        self.simulation_history = []  

        self.agent_14_tactical_history = []  

        self.total_dumped_waste = 0.0 

  

        total_agents = self.engine.ccs_master_records.get(start_year, self.engine.ccs_master_records[2015])["total"] 

        probs = np.array(self.engine.ccs_master_records.get(start_year, self.engine.ccs_master_records[2015])["pcts"], dtype=float) 

        probs /= probs.sum() 

  

        agent_id = 1 

        for region in self.engine.regions: 

            r_count = int(total_agents * {"North": 0.28, "Midlands": 0.27, "South_West_Thames": 0.20, "East_South_East": 0.25}[region]) 

            for _ in range(r_count): 

                tier_roll = random.random() 

                op = SpatialOperatorAgent( 

                    unique_id=agent_id, model=self, lat_long=CITY_COORDINATES[random.choice(EA_OPERATIONAL_AREAS[region])],  

                    facility_type=random.choice(list(self.engine.facility_matrix.keys())),  

                    initial_rating=np.random.choice(["A", "B", "C", "D", "E", "F"], p=probs), 

                    tier="small" if tier_roll < 0.6 else ("medium" if tier_roll < 0.85 else "large"), 

                    cost_pressure=random.uniform(0.7, 1.0) if tier_roll < 0.6 else (random.uniform(0.4, 0.7) if tier_roll < 0.85 else random.uniform(0.1, 0.4)) 

                ) 

                self.grid.place_agent(op, (0, 0)) 

                self.agents.add(op) 

                agent_id += 1 

  

    def step(self): 

        active_ops = [a for a in self.agents if isinstance(a, SpatialOperatorAgent) and not a.is_bankrupt] 

        if self.current_month == 1: 

            for agent in active_ops: agent.update_annual_compliance_with_contagion(self.current_year, active_ops) 

         

        self.engine.step_environmental_physics(active_ops) 

  

        for agent in active_ops: 

            agent.step() 

            vol = max(5.0, 35.0 * (agent.daily_processing_rate_r_i / 200.0) * (1.25 if self.current_year >= 2026 else 1.0) * math.exp(self.random.gauss(0.0, 0.3))) 

            agent.process_incoming_consignment(vol) 

            if not agent.is_stabilized or agent.is_tax_arbitrage or agent.is_treatment_arbitrage or agent.is_capacity_arbitrage: 

                self.total_dumped_waste += vol 

  

        if self.inspector_agent:  

            self.inspector_agent.execute_inspections(active_ops) 

  

            if self.current_year >= 2025: 

                target_agent = next((a for a in active_ops if a.unique_id == TARGET_AGENT_ID), None) 

                if target_agent: 

                    reg_idx = self.inspector_agent.last_action // 4 

                    tactic = self.inspector_agent.last_action % 4 

                     

                    # Record Agent 14 tactical state whenever inspected or targeted 

                    self.agent_14_tactical_history.append({ 

                        "tactic": tactic, 

                        "true_compliance": target_agent.true_compliance, 

                        "is_arb": (target_agent.is_tax_arbitrage or target_agent.is_treatment_arbitrage or target_agent.is_capacity_arbitrage), 

                        "omega": target_agent.pollution_trace_omega 

                    }) 

  

        if self.current_month == 12: 

            compliance_count = sum(1 for a in active_ops if getattr(a, 'true_compliance', 1.0) == 1.0) 

            comp_rate = (compliance_count / max(1, len(active_ops))) * 100.0 

             

            target_agent = next((a for a in active_ops if a.unique_id == TARGET_AGENT_ID), None) 

            agent_states_list = [] 

            if target_agent: 

                agent_states_list.append({ 

                    "id": TARGET_AGENT_ID, 

                    "true_compliance": target_agent.true_compliance, 

                    "tax_arb": target_agent.is_tax_arbitrage, 

                    "cap_arb": target_agent.is_capacity_arbitrage, 

                    "omega": target_agent.pollution_trace_omega, 

                    "financial_reserves": target_agent.financial_reserves 

                }) 

  

            self.simulation_history.append({ 

                "year": self.current_year, 

                "month": 12, 

                "true_compliance_rate": comp_rate, 

                "agent_states": agent_states_list 

            }) 

  

        self.current_month += 1 

        if self.current_month > 12: 

            self.current_month = 1 

            self.current_year += 1 

            if self.inspector_agent and self.current_year >= 2025: 

                self.inspector_agent.epsilon = max(0.02, self.inspector_agent.epsilon * 0.50) 

  

  

