    initial_trace = go.Scattergeo(
        lon=lons_init,
        lat=lats_init,
        mode='markers',
        marker=dict(
            size=9,
            color=colors_init,
            line=dict(color=border_colors_init, width=border_widths_init),
            opacity=0.85
        ),
        text=hover_init,
        hoverinfo='text'
    )
    initial_data.append(initial_trace)

    slider_steps = []
    for yr in sorted_years:
        agents_yr = yearly_snapshots[yr]
        lons, lats, cols, b_cols, b_widths, hvs = [], [], [], [], [], []
        
        for a in agents_yr:
            aid = a["id"]
            if aid in agent_pos_map and agent_pos_map[aid]:
                lon, lat = agent_pos_map[aid]
                lons.append(lon)
                lats.append(lat)
                
                rating = a.get("rating", "A")
                cols.append(band_colors.get(rating, "#1f77b4"))
                
                is_rogue = a.get("tax_arb", False) or a.get("treat_arb", False) or (a.get("true_compliance", 1.0) == 0.0)
                if is_rogue:
                    b_cols.append("red")
                    b_widths.append(2.5)
                else:
                    b_cols.append("black")
                    b_widths.append(0.5)
                    
                hvs.append(f"Year: {yr}<br>ID: {aid}<br>Region: {a['region']}<br>Rating: {rating}<br>Rogue: {is_rogue}")

        frame_data = go.Scattergeo(
            lon=lons,
            lat=lats,
            mode='markers',
            marker=dict(
                size=9,
                color=cols,
                line=dict(color=b_cols, width=b_widths),
                opacity=0.85
            ),
            text=hvs,
            hoverinfo='text'
