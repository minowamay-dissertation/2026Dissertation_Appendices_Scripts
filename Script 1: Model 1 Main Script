class SpatialOperatorAgent(Agent):
    def __init__(self, unique_id, model, lat_long=None, facility_type="Transfer", initial_rating="A", tier="small", cost_pressure=0.5):
        super().__init__(model)
        self.unique_id = unique_id
        self.lat_long = lat_long
        self.region = self.model.engine.assign_ea_region(lat_long)
        self.facility_type = facility_type
         
        # Market segments and vulnerability parameters
        self.tier = tier
        self.cost_pressure = cost_pressure

        matrix_specs = self.model.engine.facility_matrix.get(facility_type, {"R_i": 200.0, "T_i": 75000.0})
        self.max_storage_s_i = 50000.0
        self.current_inventory_i_it = 0.0
        self.daily_processing_rate_r_i = matrix_specs["R_i"]
        self.annual_throughput_limit_t_i = matrix_specs["T_i"]
        self.cumulative_annual_intake_a_i = 0.0
         
        self.financial_reserves = model.random.uniform(20000.0, 80000.0)
        self.baseline_operational_cost = 14000.0
        self.rating = initial_rating
        self.is_bankrupt = False
        self.historical_breaches = 0
         
        self.risk_tolerance = np.random.beta(2, 4)
        self.perceived_impunity = 0.0
        self.preferred_target_region = self.region
         
        self.is_tax_arbitrage = initial_rating in ["C", "D", "E", "F"]
        self.is_treatment_arbitrage = initial_rating in ["D", "E", "F"] and facility_type in ["Treatment", "MRS"]
        self.is_capacity_arbitrage = False
        self.is_stabilized = initial_rating in ["A", "B", "C"]
        self.true_compliance = 1.0 if initial_rating in ["A", "B"] else 0.0

        if not self.is_stabilized and facility_type in ["Treatment", "MRS"]:
            self.untreated_inventory = 1000.0
            self.pollution_trace_omega = 2.0
        else:
            self.pollution_trace_omega = 0.0

    def calculate_local_contagion(self, all_operators, spatial_radius=50.0):
        """
        Calculates the pressure exerted by neighboring operators within a spatial radius 
        who are currently engaging in illegal waste management.
        """
        nearby_rogue_count = 0
        search_radius = spatial_radius / 150.0 * self.model.grid.width
        total_nearby = 0
         
        for other in all_operators:
            if other.unique_id == self.unique_id or not other.lat_long or not self.lat_long:
                continue
                 
            distance = math.sqrt((self.lat_long[0] - other.lat_long[0])**2 + (self.lat_long[1] - other.lat_long[1])**2)
        
            if distance <= search_radius:
                total_nearby += 1
                if getattr(other, 'true_compliance', 1.0) == 0.0 or other.is_tax_arbitrage or other.is_treatment_arbitrage:
                    nearby_rogue_count += 1
                     
        if total_nearby == 0:
            return 0.0
             
        return nearby_rogue_count / total_nearby

    def update_behavioral_complexities(self, current_year):
        """
        Incorporates Social Learning, Financial Distress, and Cat-and-Mouse Evasion.
        """
        if self.is_bankrupt:
            return

        # --- MECHANISM 1: Social Learning & Local Peer Influence ---
        neighbors = self.model.grid.get_neighbors(self.pos, moore=True, include_center=False, radius=4)
        peer_agents = [a for a in neighbors if isinstance(a, SpatialOperatorAgent) and not a.is_bankrupt]
         
        peer_impunity_ratio = 0.0
        if peer_agents:
            rogue_peers = sum(1 for p in peer_agents if p.is_tax_arbitrage or p.is_treatment_arbitrage or getattr(p, 'true_compliance', 1.0) == 0.0)
            peer_impunity_ratio = rogue_peers / len(peer_agents)

        # --- MECHANISM 2: Financial Distress & Capital Desperation ---
        burn_rate = max(1.0, self.baseline_operational_cost)
        cash_runway_months = self.financial_reserves / burn_rate
         
        desperation_factor = 2.5 if cash_runway_months < 3.0 else 1.0

        # --- MECHANISM 3: Cat-and-Mouse Evasion Tactics ---
        regional_pressure = self.model.regional_enforcement_pressure.get(self.region, 0.1)
         
        true_evasion = False
        if regional_pressure > 0.4 and self.tier == "large":
            if random.random() < 0.7:  
                true_evasion = True

        # --- Composite Non-Compliance Probability Update ---
        if true_evasion:
            self.is_tax_arbitrage = False
            self.is_treatment_arbitrage = False
            self.true_compliance = 1.0
            self.is_stabilized = True
        else:
            base_prob = 0.20 + (self.cost_pressure * 0.3)
            composite_prob = min(1.0, (base_prob + (peer_impunity_ratio * 0.4)) * desperation_factor)
             
            if current_year >= 2026:
                composite_prob *= 0.85

            if random.random() < composite_prob:
                self.true_compliance = 0.0
                self.is_tax_arbitrage = True
                self.is_stabilized = False
                if self.facility_type in ["Treatment", "MRS"]:
                    self.is_treatment_arbitrage = True
            else:
                self.true_compliance = 1.0
                self.is_tax_arbitrage = False
                self.is_treatment_arbitrage = False
                self.is_stabilized = True

    def update_annual_compliance_with_contagion(self, current_year, all_operators):
        """
        Dynamic compliance update driven by market vulnerability splits, 
        spatial contagion pressure, and historical CCS benchmark distributions.
        """
        if current_year <= 2024:
            yr_record = self.model.engine.ccs_master_records.get(current_year, self.model.engine.ccs_master_records[2024])
            raw_historical = np.array(yr_record["pcts"], dtype=float)
            historical_probs = raw_historical / raw_historical.sum()
            
            self.rating = np.random.choice(["A", "B", "C", "D", "E", "F"], p=historical_probs)
            
            if self.rating in ["A", "B"]:
                self.true_compliance = 1.0
                self.is_stabilized = True
                self.is_tax_arbitrage = False
                self.is_treatment_arbitrage = False
            else:
                self.true_compliance = 0.0
                self.is_stabilized = False
                self.is_tax_arbitrage = True
                self.is_treatment_arbitrage = True if self.facility_type in ["Treatment", "MRS"] else False
        else:
            self.update_behavioral_complexities(current_year)
            if self.true_compliance == 1.0:
                self.rating = random.choice(["A", "B"])
            else:
                self.rating = random.choice(["C", "D", "F"])

    def evaluate_peer_pressure(self):
        if not self.pos:
            return 0.0
             
        neighbors = self.model.grid.get_neighbors(self.pos, moore=True, include_center=False, radius=3)
        peer_agents = [a for a in neighbors if isinstance(a, SpatialOperatorAgent) and not a.is_bankrupt]
         
        if not peer_agents:
            return 0.0
             
        arbitrage_count = sum(1 for p in peer_agents if p.is_tax_arbitrage or p.is_treatment_arbitrage)
        peer_pressure_ratio = arbitrage_count / len(peer_agents)
        return peer_pressure_ratio

    def evaluate_spatial_crime_displacement(self):
        """
        True Geographic Gravity Model: Weighs enforcement pressure, 
        regional capacity, AND real inter-regional distance friction.
        """
        regional_heatmaps = getattr(self.model, 'regional_enforcement_pressure', {r: 0.1 for r in self.model.engine.regions})
        regions = self.model.engine.regions
        current_region = self.region
        distance_lookup = self.model.engine.distance_matrix[current_region]
         
        region_scores = {}
        for r in regions:
            pressure = regional_heatmaps.get(r, 0.1)
             
            current_load = sum(
                rec.get("regional_illegal_waste", {}).get(r, 0.0) 
                for rec in self.model.simulation_history[-3:]
            )
            capacity_penalty = 1.0 + (current_load / 500000.0)
             
            distance_friction = distance_lookup.get(r, 10.0)
            beta_decay = 0.05
            
            exponent = min(700.0, beta_decay * distance_friction)
            spatial_impedance = math.exp(exponent)
             
            attraction = 1.0 / (pressure * capacity_penalty * spatial_impedance)
            region_scores[r] = max(0.001, attraction)
             
        total_score = sum(region_scores.values())
        probs = [region_scores[r] / total_score for r in regions]
         
        self.preferred_target_region = np.random.choice(regions, p=probs)

    def evaluate_rational_choice_expected_utility(self, reward_r, severity_s):
        p_detection = getattr(self, 'dynamic_detection_probability', 0.05)
        adjusted_p_detection = max(0.01, p_detection - (self.perceived_impunity * 0.1))
        expected_utility = reward_r - (adjusted_p_detection * severity_s)
        return expected_utility

    def process_incoming_consignment(self, volume_v):
        if self.is_bankrupt:
            return

        peer_ratio = self.evaluate_peer_pressure()
        self.perceived_impunity = peer_ratio
        self.evaluate_spatial_crime_displacement()

        burn_rate = max(1.0, self.baseline_operational_cost)
        cash_runway_months = self.financial_reserves / burn_rate
        resource_stress = max(1.0, 4.0 / max(0.1, cash_runway_months))
        effective_risk_tolerance = self.risk_tolerance * resource_stress

        std_tax, inert_tax = self.model.engine.get_tax_rates(self.model.current_year)
         
        reward_r_tax = volume_v * (std_tax - inert_tax)
        severity_s_tax = volume_v * std_tax * 1.5
        eu_tax = self.evaluate_rational_choice_expected_utility(reward_r_tax, severity_s_tax)

        raw_tax_arb = (eu_tax > 0) and (effective_risk_tolerance + (self.perceived_impunity * 0.3) > 0.3)
        
        alpha = 0.2 
        current_tax_state = 1.0 if raw_tax_arb else 0.0
        prev_tax_state = 1.0 if getattr(self, 'is_tax_arbitrage', False) else 0.0
        smoothed_tax_state = (1 - alpha) * prev_tax_state + alpha * current_tax_state
        self.is_tax_arbitrage = smoothed_tax_state >= 0.5

        if self.is_tax_arbitrage:
            self.financial_reserves += reward_r_tax

        if self.facility_type in ["Treatment", "MRS"]:
            c_treat = 50.0
            reward_r_treat = volume_v * c_treat
            severity_s_treat = volume_v * (c_treat * 2.0)
            eu_treat = self.evaluate_rational_choice_expected_utility(reward_r_treat, severity_s_treat)

            raw_treat_arb = (eu_treat > 0) and (effective_risk_tolerance + (self.perceived_impunity * 0.3) > 0.35)
            current_treat_state = 1.0 if raw_treat_arb else 0.0
            prev_treat_state = 1.0 if getattr(self, 'is_treatment_arbitrage', False) else 0.0
            smoothed_treat_state = (1 - alpha) * prev_treat_state + alpha * current_treat_state
            self.is_treatment_arbitrage = smoothed_treat_state >= 0.5
             
            financial_delta, _ = self.model.engine.execute_treatment_arbitrage_state(
                node=self,
                volume_v=volume_v,
                c_trt=c_treat,
                is_arbitrage=self.is_treatment_arbitrage
            )
            self.financial_reserves += financial_delta
          
        self.current_inventory_i_it += volume_v
         
        if self.current_inventory_i_it > self.max_storage_s_i:
            overflow_excess = self.current_inventory_i_it - self.max_storage_s_i
            storage_penalty = overflow_excess * 45.0  
            self.financial_reserves -= storage_penalty
            self.current_inventory_i_it = self.max_storage_s_i  
            self.is_capacity_arbitrage = True
        else:
            self.is_capacity_arbitrage = False

        self.cumulative_annual_intake_a_i += volume_v

    def step(self):
        if self.is_bankrupt:
            return
              
        revenue = self.model.random.uniform(14500.0, 23000.0)
        self.financial_reserves += (revenue - self.baseline_operational_cost)
         
        if self.financial_reserves <= 0:
            self.is_bankrupt = True
            self.rating = "F"

