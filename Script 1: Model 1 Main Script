        frames.append(go.Frame(data=[frame_data], name=str(yr)))
        
        slider_steps.append({
            'args': [[str(yr)], {'frame': {'duration': 300, 'redraw': True}, 'mode': 'immediate'}],
            'label': str(yr),
            'method': 'animate'
        })

    layout = go.Layout(
        title_text="Figure 0. Interactive Longitudinal ABM Operator Map & Compliance Evolution (2015–2036)",
        geo=dict(
            scope='europe',
            center=dict(lat=53.0, lon=-1.5),
            lonaxis=dict(range=[-6.0, 2.5]),
            lataxis=dict(range=[50.0, 56.0]),
            showland=True,
            landcolor="#f4f4f4",
            subunitcolor="#dddddd",
            countrycolor="#bbbbbb"
