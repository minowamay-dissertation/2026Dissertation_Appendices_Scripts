    for col in ["Final_Compliance_Rate", "Final_Coverage", "Total_Illegal_Tonnage"]:
        vals = df_mc[col].values
        mean_val = np.mean(vals)
        median_val = np.median(vals)
        std_val = np.std(vals, ddof=1)
        iqr_val = np.percentile(vals, 75) - np.percentile(vals, 25)
        ci_95 = stats.t.interval(0.95, len(vals)-1, loc=mean_val, scale=stats.sem(vals))
        shapiro_stat, shapiro_p = stats.shapiro(vals)
        
        print(f"Metric: {col}")
        print(f"  Mean: {mean_val:.2f} | Median: {median_val:.2f} | SD: {std_val:.2f} | IQR: {iqr_val:.2f}")
        print(f"  95% Confidence Interval: ({ci_95[0]:.2f}, {ci_95[1]:.2f})")
        print(f"  Shapiro-Wilk Normality Test: p-value = {shapiro_p:.4f} ({'Normal' if shapiro_p > 0.05 else 'Non-Normal'})")

