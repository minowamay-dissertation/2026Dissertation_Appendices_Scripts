class SpatialWasteMarketModel(Model):
    def __init__(self, width=150, height=150, start_year=2015, seed=42):
        super().__init__()
        random.seed(seed)
        np.random.seed(seed)
         
        self.grid = MultiGrid(width, height, torus=True)
        self.current_year = start_year
        self.current_month = 1
        self.inspection_strategy = "rl_learning"
         
        self.engine = WasteComplianceEngine(simulation_year=start_year)
        self.simulation_history = []
        self.total_dumped_waste = 0.0
        self.cross_border_flow_matrix = {r: {reg: 0.0 for reg in self.engine.regions} for r in self.engine.regions}
        self.regional_enforcement_pressure = {r: 0.1 for r in self.engine.regions}

        self.inspector_agent = EAInspectorRLAgent(unique_id=9999, model=self)

        start_yr_record = self.engine.ccs_master_records.get(start_year, self.engine.ccs_master_records[2015])
        raw_start_probs = np.array(start_yr_record["pcts"], dtype=float)
        historical_band_probs = raw_start_probs / raw_start_probs.sum()
         
        # Instantiate the full ~14,229 agent dataset for 2015 directly from CCS master distributions
        total_target_agents = start_yr_record["total"]
        print(f"Instantiating full empirical population of {total_target_agents:,} operators for year {start_year}...")
         
        region_weights = {"North": 0.28, "Midlands": 0.27, "South_West_Thames": 0.20, "East_South_East": 0.25}
        agent_id = 1
         
        for region in self.engine.regions:
            cities_in_region = EA_OPERATIONAL_AREAS[region]
            region_geom = self.engine.ea_regions_gdf[self.engine.ea_regions_gdf["Region"] == region].geometry.iloc[0]
            region_count = int(total_target_agents * region_weights[region])
            
            for _ in range(region_count):
                city_name = random.choice(cities_in_region)
                base_lng, base_lat = CITY_COORDINATES.get(city_name, (-1.5, 53.0))
                 
                valid_location = False
                attempts = 0
                x, y = base_lng, base_lat
                while not valid_location and attempts < 100:
                    test_x = base_lng + random.uniform(-0.35, 0.35)
                    test_y = base_lat + random.uniform(-0.25, 0.25)
                    if Point(test_x, test_y).within(region_geom):
                        x, y = test_x, test_y
                        valid_location = True
                    attempts += 1
                 
                facility_type = random.choice(list(self.engine.facility_matrix.keys()))
                initial_rating = np.random.choice(["A", "B", "C", "D", "E", "F"], p=historical_band_probs)
                 
                tier_roll = random.random()
                if tier_roll < 0.60:
                    tier = "small"
                    cost_pressure = random.uniform(0.7, 1.0)
                elif tier_roll < 0.85:
                    tier = "medium"
                    cost_pressure = random.uniform(0.4, 0.7)
                else:
                    tier = "large"
                    cost_pressure = random.uniform(0.1, 0.4)

                op = SpatialOperatorAgent(
                    unique_id=agent_id, 
                    model=self, 
                    lat_long=(x, y), 
                    facility_type=facility_type, 
                    initial_rating=initial_rating,
                    tier=tier,
                    cost_pressure=cost_pressure
                )
                 
                grid_x = int(min(width - 1, max(0, (x - (-5.7)) / (1.8 - (-5.7)) * width)))
                grid_y = int(min(height - 1, max(0, (y - 50.0) / (55.9 - 50.0) * height)))
                 
                self.grid.place_agent(op, (grid_x, grid_y))
                self.agents.add(op)
                agent_id += 1

        # Print explicit regional and tier audit breakdown
        print("\n=== INITIALIZATION: REGIONAL & TIER AGENT BREAKDOWN ===")
        all_ops = [a for a in self.agents if isinstance(a, SpatialOperatorAgent)]
        for reg in self.engine.regions:
            reg_ops = [o for o in all_ops if o.region == reg]
            s_count = sum(1 for o in reg_ops if o.tier == "small")
            m_count = sum(1 for o in reg_ops if o.tier == "medium")
            l_count = sum(1 for o in reg_ops if o.tier == "large")
            print(f"Region: {reg:<18} | Total: {len(reg_ops):<6} | Small: {s_count:<5} | Medium: {m_count:<5} | Large: {l_count:<5}")
        print("=" * 60)

    def calculate_detected_incidents(self, audit_coverage):
        active_ops = [a for a in self.agents if isinstance(a, SpatialOperatorAgent) and not a.is_bankrupt]
        true_violations = [op for op in active_ops if getattr(op, 'true_compliance', 1.0) == 0.0]
        detected_incidents = []
         
        reporting_gap_factor = 0.27 
         
        for violation in true_violations:
            is_audited = random.random() < audit_coverage
            is_reported = random.random() < reporting_gap_factor
             
            if is_audited or is_reported:
                detected_incidents.append(violation)
                 
        return detected_incidents

    def step(self):
        active_ops = [a for a in self.agents if isinstance(a, SpatialOperatorAgent) and not a.is_bankrupt]
         
        if self.current_month == 1:
            for agent in active_ops:
                agent.update_annual_compliance_with_contagion(self.current_year, active_ops)

        self.engine.step_environmental_physics(active_ops)
        if self.inspector_agent:
            self.inspector_agent.execute_inspections(active_ops)

        regional_waste_flows = {r: {dest: 0.0 for dest in self.engine.regions} for r in self.engine.regions}
        regional_illegal_waste = {r: 0.0 for r in self.engine.regions}

        for agent in active_ops:
            agent.step()
             
            base_profile_mult = 1.25 if self.current_year >= 2026 else 1.0
            throughput_capacity_factor = agent.daily_processing_rate_r_i / 200.0
            noise_term = math.exp(self.random.gauss(0.0, 0.3))
            consignment_volume = max(50.0, 300.0 * throughput_capacity_factor * base_profile_mult * noise_term)

            agent.process_incoming_consignment(consignment_volume)
             
            origin = agent.region
            target = getattr(agent, 'preferred_target_region', origin)
            regional_waste_flows[origin][target] += consignment_volume

            if not agent.is_stabilized or agent.is_tax_arbitrage or agent.is_treatment_arbitrage or getattr(agent, 'true_compliance', 1.0) == 0.0:
                regional_illegal_waste[origin] += consignment_volume
                self.total_dumped_waste += consignment_volume

        recent_illegal_spike = sum(regional_illegal_waste.values())
        if recent_illegal_spike > 15000.0:
            if self.inspector_agent:
                self.inspector_agent.epsilon = min(0.75, self.inspector_agent.epsilon + 0.25)

        for agent in list(self.agents):
            if isinstance(agent, SpatialOperatorAgent) and agent.is_bankrupt:
                if not hasattr(agent, 'bankruptcy_duration'):
                    agent.bankruptcy_duration = 0
                agent.bankruptcy_duration += 1
                 
                if agent.bankruptcy_duration > 12:
                    if agent.pos is not None:
                        try:
                            self.grid.remove_agent(agent)
                        except Exception:
                            pass
                    self.agents.remove(agent)
                     
                    region = random.choice(self.engine.regions)
                    cities_in_region = EA_OPERATIONAL_AREAS[region]
                    region_geom = self.engine.ea_regions_gdf[self.engine.ea_regions_gdf["Region"] == region].geometry.iloc[0]
                    
                    city_name = random.choice(cities_in_region)
                    base_lng, base_lat = CITY_COORDINATES.get(city_name, (-1.5, 53.0))
                     
                    valid_location = False
                    attempts = 0
                    x, y = base_lng, base_lat
                    while not valid_location and attempts < 100:
                        test_x = base_lng + random.uniform(-0.35, 0.35)
                        test_y = base_lat + random.uniform(-0.25, 0.25)
                        if Point(test_x, test_y).within(region_geom):
                            x, y = test_x, test_y
                            valid_location = True
                        attempts += 1

                    new_id = agent.unique_id
                    facility_type = random.choice(list(self.engine.facility_matrix.keys()))
                    
                    tier_roll = random.random()
                    if tier_roll < 0.60:
                        tier = "small"
                        cost_pressure = random.uniform(0.7, 1.0)
                    elif tier_roll < 0.85:
                        tier = "medium"
                        cost_pressure = random.uniform(0.4, 0.7)
                    else:
                        tier = "large"
                        cost_pressure = random.uniform(0.1, 0.4)

                    new_op = SpatialOperatorAgent(
                        unique_id=new_id, 
                        model=self, 
                        lat_long=(x, y), 
                        facility_type=facility_type, 
                        initial_rating="A",
                        tier=tier,
                        cost_pressure=cost_pressure
                    )
                     
                    grid_x = int(min(self.grid.width - 1, max(0, (x - (-5.7)) / (1.8 - (-5.7)) * self.grid.width)))
                    grid_y = int(min(self.grid.height - 1, max(0, (y - 50.0) / (55.9 - 50.0) * self.grid.height)))

                    self.grid.place_agent(new_op, (grid_x, grid_y))
                    self.agents.add(new_op)

        inspected_count = sum(1 for a in active_ops if getattr(a, 'inspected_this_cycle', False))
        coverage_pct = (inspected_count / max(1, len(active_ops))) * 100.0

        compliance_count = sum(1 for a in active_ops if getattr(a, 'true_compliance', 1.0) == 1.0 and not a.is_tax_arbitrage and not a.is_treatment_arbitrage and a.is_stabilized)
        true_comp_rate = (compliance_count / max(1, len(active_ops))) * 100.0
         
        agent_states_snapshot = [{
            "id": a.unique_id,
            "region": a.region,
            "preferred_target_region": getattr(a, 'preferred_target_region', a.region),
            "financial_reserves": a.financial_reserves,
            "rating": a.rating,
            "tax_arb": a.is_tax_arbitrage,
            "cap_arb": getattr(a, 'is_capacity_arbitrage', False),
            "treat_arb": a.is_treatment_arbitrage,
            "is_stabilized": getattr(a, 'is_stabilized', True),
            "is_bankrupt": a.is_bankrupt,
            "true_compliance": getattr(a, 'true_compliance', 1.0),
            "omega": getattr(a, 'pollution_trace_omega', 0.0)
        } for a in self.agents if isinstance(a, SpatialOperatorAgent)]

        self.simulation_history.append({
            "year": self.current_year,
            "month": self.current_month,
            "true_compliance_rate": true_comp_rate,
            "coverage": coverage_pct,
            "epsilon": getattr(self.inspector_agent, 'epsilon', 0.1),
            "regional_illegal_waste": regional_illegal_waste,
            "regional_waste_flows": regional_waste_flows,
            "agent_states": agent_states_snapshot
        })

        self.current_month += 1
        if self.current_month > 12:
            self.current_month = 1
            self.current_year += 1
            if self.inspector_agent:
                self.inspector_agent.epsilon = max(0.05, self.inspector_agent.epsilon * 0.90)

