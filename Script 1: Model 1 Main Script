    def assign_ea_region(self, pos):
        """True spatial point-in-polygon containment check across England's regional geometry."""
        if pos is None:
            return "Midlands"
        point = Point(pos)
        for _, row in self.ea_regions_gdf.iterrows():
            if point.within(row["geometry"]):
                return row["Region"]
        closest_reg = min(self.region_coordinates.keys(), key=lambda r: Point(pos).distance(Point(self.region_coordinates[r])))
        return closest_reg

    def get_tax_rates(self, year):
        """Global Macro Layer: Administrative tax rate lookup."""
        safe_year = min(max(year, 2015), 2036)
        return self.historical_tax_rates[safe_year]["std"], self.historical_tax_rates[safe_year]["inert"]

    def step_environmental_physics(self, facility_nodes):
        """
        Micro Node Mutation Loop:
        Processes active physical trace updates specifically for nodes restricted 
        to Treatment or MRS facility types (Layer A & Layer B dynamics).
        """
        for node in facility_nodes:
            if getattr(node, 'is_bankrupt', False):
                continue

            if getattr(node, 'facility_type', None) in ["Treatment", "MRS"]:
                if getattr(node, 'is_stabilized', True) == False and getattr(node, 'untreated_inventory', 0.0) > 0:
                    if not hasattr(node, 'pollution_trace_omega'):
                        node.pollution_trace_omega = 0.0
                    node.pollution_trace_omega += (node.untreated_inventory * 0.002)
                    
                    p_floor = 0.05
                    gamma = 0.1
                    node.dynamic_detection_probability = min(1.0, p_floor + (gamma * node.pollution_trace_omega))
                else:
                    if hasattr(node, 'pollution_trace_omega'):
                        node.pollution_trace_omega = max(0.0, node.pollution_trace_omega - 0.05)
                    node.dynamic_detection_probability = 0.05

    def execute_treatment_arbitrage_state(self, node, volume_v, c_trt, h_raw=1.0, h_legal=0.1, is_arbitrage=False):
        """
        Micro State Mutation: Evaluates whether a Treatment/MRS node operates legally 
        or triggers Treatment Arbitrage (Layer A: Untreated Asset State accumulation).
        """
        if is_arbitrage:
            if not hasattr(node, 'untreated_inventory'):
                node.untreated_inventory = 0.0
            node.untreated_inventory += volume_v
            node.is_stabilized = False
            node.hazard_intensity = h_raw
            
            saved_profit_margin = volume_v * c_trt
            return saved_profit_margin, False
        else:
            node.is_stabilized = True
            node.hazard_intensity = h_legal
            
            if hasattr(node, 'untreated_inventory'):
                node.untreated_inventory = max(0.0, node.untreated_inventory - volume_v)
                
            cost_incurred = volume_v * c_trt
            return -cost_incurred, True

    def calculate_remediation_penalty(self, volume_v, c_trt, beta_clean=2.0):
        """
        Penalty Architecture: Balanced fine architecture.
        """
        return volume_v * (c_trt * beta_clean)

