            fontsize=10, fontweight="bold", color="#111111",
            ha="center", va="center",
            bbox=dict(facecolor="white", alpha=0.75, edgecolor="#888888", boxstyle="round,pad=0.3"),
            zorder=6
        )

    # 2. Extract Active Operators
    active_ops = [a for a in model.agents if isinstance(a, SpatialOperatorAgent) and a.lat_long and not a.is_bankrupt]
    
    # Separate Operators by Risk & Tier
    rogue_large = []
    rogue_mid = []
    rogue_small = []
    compliant_ops = []
    
    for op in active_ops:
        is_rogue = (getattr(op, 'true_compliance', 1.0) == 0.0 or op.is_tax_arbitrage or op.is_treatment_arbitrage)
        if is_rogue:
            if op.tier == "large":
                rogue_large.append(op)
            elif op.tier == "medium":
                rogue_mid.append(op)
            else:
                rogue_small.append(op)
        else:
            compliant_ops.append(op)

    # Downsample compliant operators for visual clarity (blurred background)
    sample_size = min(1500, len(compliant_ops))
    compliant_sample = random.sample(compliant_ops, sample_size) if compliant_ops else []

    # 3. Plot Compliant Operators (Blurred Blue Dots, sized by tier)
    for op in compliant_sample:
        sz = 45 if op.tier == "large" else (22 if op.tier == "medium" else 8)
