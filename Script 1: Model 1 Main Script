def visualize_contagion_network(model, spatial_threshold=2.0):
    """
    Strictly constrained to A4 portrait dimensions (figsize=(8.27, 11.69)).
    """
    fig, ax = plt.subplots(figsize=(8.27, 11.69))
     
    gdf = model.engine.ea_regions_gdf
    gdf.plot(ax=ax, color="#f7f7f7", edgecolor="#444444", linewidth=1.0, alpha=0.9)
     
    active_ops = [a for a in model.agents if isinstance(a, SpatialOperatorAgent) and a.lat_long]
     
    for op_i in active_ops:
        is_rogue = (getattr(op_i, 'true_compliance', 1.0) == 0.0 or op_i.is_tax_arbitrage or op_i.is_treatment_arbitrage)
        is_large = (op_i.tier == "large")
        
        if is_rogue or is_large:
            x0, y0 = op_i.lat_long
            for op_j in active_ops:
                if op_i.unique_id == op_j.unique_id:
                    continue
                x1, y1 = op_j.lat_long
                dist = math.sqrt((x0 - x1)**2 + (y0 - y1)**2)
                if dist <= spatial_threshold:
                    is_major_stream = is_rogue and is_large
                    line_alpha = 0.4 if is_major_stream else 0.1
                    line_color = "#d62728" if is_major_stream else "#888888"
                    line_width = 0.6 if is_major_stream else 0.2
                    ax.plot([x0, x1], [y0, y1], color=line_color, linewidth=line_width, alpha=line_alpha, zorder=2)

    categories = {
        "Large Compliant (Dimmed)": {"ops": [op for op in active_ops if op.tier == "large" and op.true_compliance == 1.0], "color": "#7fbfff", "size": 35, "marker": "o", "alpha": 0.35},
        "Medium/Small Compliant": {"ops": [op for op in active_ops if op.tier in ["small", "medium"] and op.true_compliance == 1.0], "color": "#aed2ff", "size": 12, "marker": "o", "alpha": 0.25},
        "Large Operator / Rogue Hub": {"ops": [op for op in active_ops if op.tier == "large" and (op.true_compliance < 1.0 or op.is_tax_arbitrage)], "color": "#d62728", "size": 60, "marker": "o", "alpha": 0.90},
        "Small/Medium Rogue Operator": {"ops": [op for op in active_ops if op.tier in ["small", "medium"] and (op.true_compliance < 1.0 or op.is_tax_arbitrage)], "color": "#ff7f0e", "size": 25, "marker": "o", "alpha": 0.80}
    }

    for cat_name, specs in categories.items():
        xs = [op.lat_long[0] for op in specs["ops"]]
        ys = [op.lat_long[1] for op in specs["ops"]]
        if xs:
            ax.scatter(xs, ys, color=specs["color"], s=specs["size"], marker=specs["marker"], 
                       edgecolor="black", linewidth=0.4, alpha=specs["alpha"], label=cat_name, zorder=4 if "Rogue" in cat_name or "Hub" in cat_name else 3)

    unregulated_sinks_x = []
    unregulated_sinks_y = []
    for op in active_ops:
        if getattr(op, 'true_compliance', 1.0) == 0.0 and op.lat_long:
            reg_geom = gdf[gdf["Region"] == op.region].geometry.iloc[0]
             
            valid_leak = False
            attempts = 0
            leak_x, leak_y = op.lat_long[0], op.lat_long[1]
             
            while not valid_leak and attempts < 50:
                test_x = op.lat_long[0] + random.uniform(-0.15, 0.15)
                test_y = op.lat_long[1] + random.uniform(-0.1, 0.1)
                if Point(test_x, test_y).within(reg_geom):
                    leak_x, leak_y = test_x, test_y
                    valid_leak = True
                attempts += 1
                 
            unregulated_sinks_x.append(leak_x)
            unregulated_sinks_y.append(leak_y)
            ax.plot([op.lat_long[0], leak_x], [op.lat_long[1], leak_y], color="#8c564b", linestyle=":", linewidth=0.6, alpha=0.4, zorder=2)

    if unregulated_sinks_x:
        ax.scatter(unregulated_sinks_x, unregulated_sinks_y, color="#8c564b", marker="x", s=18, linewidths=1.0, label="Unregulated Channel / Fly-tipping Sink", zorder=5)

    key_hubs = {
        "Newcastle": (-1.6178, 54.9783), "Leeds": (-1.5491, 53.8008), 
        "Manchester": (-2.2426, 53.4808), "Birmingham": (-1.8904, 52.4862), 
        "London": (-0.1278, 51.5074), "Bristol": (-2.5879, 51.4545),
        "Norwich": (1.2974, 52.6309), "Southampton": (-1.4043, 50.9097)
    }
    for city, (clng, clat) in key_hubs.items():
        ax.text(clng, clat, city, fontsize=7, fontweight='bold', color='#222222', 
                ha='center', va='center', bbox=dict(facecolor='white', alpha=0.7, edgecolor='none', pad=1), zorder=6)

    ax.set_title("Figure. Waste Sector Network: Rogue & Big Operator Streams", fontsize=10, fontweight="bold", pad=12)
    ax.set_aspect('equal')
    ax.set_axis_off()
    ax.legend(loc="upper right", frameon=True, fontsize=7)
     
    plt.savefig("Contagion_Network_Geographic_Map.png", dpi=300, bbox_inches="tight")
    plt.close()
    print("Refined A4 portrait contagion network map successfully generated and saved.")

def get_profile_name(a):
    if a.get("is_bankrupt", False):
        return "Insolvent / Default"
    tax = a.get("tax_arb", False)
    cap = a.get("cap_arb", False)
    treat = a.get("treat_arb", False)
    frauds = sum([tax, cap, treat])
    if frauds == 0:
        return "Fully Compliant"
    elif frauds > 1:
        return "Multi-Mode Non-Compliant"
    elif tax:
        return "Tax Arbitrage Only"
    elif treat:
        return "Treatment Arbitrage Only"
    else:
        return "Capacity Arbitrage Only"

