class EAInspectorRLAgent(Agent):
    def __init__(self, unique_id, model):
        super().__init__(model)
        self.unique_id = unique_id
        self.q_table = np.zeros((2, 2, 4, 4)) 
        self.alpha, self.gamma, self.epsilon = 0.15, 0.90, 0.60
        self.last_state = (0, 0, 0)
        self.last_action = 0
         
        self.total_audits_conducted = 0
        self.total_frauds_caught = 0
        self.displacement_events_recorded = 0

    def get_state(self):
        """
        Upgraded State Space: Ingests localized regional rogue densities instead of 
        a binary global complaint flag to pinpoint macro-clusters.
        """
        active_ops = [a for a in self.model.agents if isinstance(a, SpatialOperatorAgent) and not a.is_bankrupt]
         
        regional_rogue_counts = {r: 0 for r in self.model.engine.regions}
        for op in active_ops:
            if getattr(op, 'true_compliance', 1.0) == 0.0 or op.is_tax_arbitrage or op.is_treatment_arbitrage:
                regional_rogue_counts[op.region] += 1

        dwt_active = 1 if self.model.current_year >= 2026 else 0
         
        highest_rogue_region = max(regional_rogue_counts, key=regional_rogue_counts.get)
        region_idx = self.model.engine.regions.index(highest_rogue_region)
        density_flag = 1 if regional_rogue_counts[highest_rogue_region] > 5 else 0

        return (density_flag, dwt_active, region_idx)

    def execute_inspections(self, active_ops):
        strategy = getattr(self.model, 'inspection_strategy', 'rl_learning')
        
        inspection_batch_size = max(int(len(active_ops) * 0.25), int(len(active_ops) * self.epsilon))

        for agent in active_ops:
            agent.inspected_this_cycle = False

        inspected_sample = []
        self.displacement_events_recorded = 0

        if strategy == "random":
            inspected_sample = random.sample(active_ops, min(inspection_batch_size, len(active_ops)))
        elif strategy == "risk_based":
            sorted_ops = sorted(
                active_ops,
                key=lambda o: (o.rating in ["D", "E", "F"], getattr(o, 'historical_breaches', 0)),
                reverse=True
            )
            inspected_sample = sorted_ops[:inspection_batch_size]
        else:
            self.last_state = self.get_state()
            self.last_action = (
                random.randint(0, len(self.model.engine.regions) - 1)
                if random.random() < self.epsilon
                else int(np.argmax(self.q_table[self.last_state]))
            )
            focus_reg = self.model.engine.regions[self.last_action]

            sorted_ops = sorted(
                active_ops,
                key=lambda o: (o.region == focus_reg, getattr(o, 'pollution_trace_omega', 0.0)),
                reverse=True
            )
            inspected_sample = sorted_ops[:inspection_batch_size]

        caught = 0
        penalties_collected = 0.0

        for agent in inspected_sample:
            agent.inspected_this_cycle = True
            self.total_audits_conducted += 1
             
            is_fraudulent = (
                agent.is_tax_arbitrage or 
                agent.is_capacity_arbitrage or 
                agent.is_treatment_arbitrage or 
                (not agent.is_stabilized)
            )
             
            if is_fraudulent:
                caught += 1
                self.total_frauds_caught += 1
                agent.historical_breaches += 1
                 
                fine = self.model.engine.calculate_remediation_penalty(volume_v=80.0, c_trt=30.0)
                agent.financial_reserves -= fine
                penalties_collected += fine
                 
                ratings_progression = {"F": "E", "E": "D", "D": "C", "C": "B", "B": "A", "A": "A"}
                agent.rating = ratings_progression.get(agent.rating, "B")
                 
                if agent.rating in ["A", "B"]:
                    agent.is_tax_arbitrage = False
                    agent.is_treatment_arbitrage = False
                    agent.is_stabilized = True
                    agent.untreated_inventory = max(0.0, getattr(agent, 'untreated_inventory', 0.0) - 500.0)
                    agent.pollution_trace_omega = max(0.0, getattr(agent, 'pollution_trace_omega', 0.0) - 1.0)

        regional_audit_counts = {r: 0 for r in self.model.engine.regions}
        for agent in inspected_sample:
            regional_audit_counts[agent.region] += 1
          
        total_audits = len(inspected_sample)
        for r in self.model.engine.regions:
            self.model.regional_enforcement_pressure[r] = max(0.05, regional_audit_counts[r] / max(1, total_audits))

        for agent in active_ops:
            if getattr(agent, 'preferred_target_region', agent.region) != agent.region:
                self.displacement_events_recorded += 1

        if strategy == "rl_learning" and active_ops:
            true_frauds = sum(1 for a in active_ops if a.is_tax_arbitrage or a.is_capacity_arbitrage or a.is_treatment_arbitrage or (not a.is_stabilized))
            missed = max(0, true_frauds - caught)

            reward = float(
                (caught * 250.0) 
                + (penalties_collected * 0.05)
                - (missed * 10.0)
                - (self.displacement_events_recorded * 1.0)
            )

            nxt = self.get_state()
            old_val = self.q_table[self.last_state + (self.last_action,)]
            self.q_table[self.last_state + (self.last_action,)] = old_val + self.alpha * (
                reward + self.gamma * np.max(self.q_table[nxt]) - old_val
            )

