def generate_regional_contagion_grid(model, spatial_threshold=1.5):
    """
    Figure 8: Generates a 2x2 small-multiples grid zooming into each macro-region
    to visualize local operator interactions, big/small rogue clusters, and intra-regional leakage paths.
    Strictly constrained to A4 portrait dimensions (figsize=(8.27, 11.69)).
    """
    regions = model.engine.ea_regions_gdf
    fig, axes = plt.subplots(2, 2, figsize=(8.27, 11.69))
    axes = axes.flatten()
     
    active_ops = [a for a in model.agents if isinstance(a, SpatialOperatorAgent) and a.lat_long]
     
    for idx, row in regions.iterrows():
        reg_name = row["Region"]
        ax = axes[idx]
         
        sub_gdf = regions[regions["Region"] == reg_name]
        sub_gdf.plot(ax=ax, color="#f9f9f9", edgecolor="#333333", linewidth=1.2, alpha=0.9)
         
        reg_ops = [op for op in active_ops if op.region == reg_name]
         
        for i, op_i in enumerate(reg_ops):
            is_rogue_i = (getattr(op_i, 'true_compliance', 1.0) == 0.0 or op_i.is_tax_arbitrage or op_i.is_treatment_arbitrage)
            is_large_i = (op_i.tier == "large")
             
            if is_rogue_i or is_large_i:
                x0, y0 = op_i.lat_long
                for op_j in reg_ops[i+1:]:
                    x1, y1 = op_j.lat_long
                    dist = math.sqrt((x0 - x1)**2 + (y0 - y1)**2)
                    if dist <= spatial_threshold:
                        is_major = is_rogue_i and is_large_i
                        ax.plot([x0, x1], [y0, y1], color="#d62728" if is_major else "#888888", 
                                linewidth=0.6 if is_major else 0.2, alpha=0.3 if is_major else 0.1, zorder=2)

        for op in reg_ops:
            is_rogue = (getattr(op, 'true_compliance', 1.0) == 0.0 or op.is_tax_arbitrage)
            color = "#d62728" if is_rogue else "#1f77b4"
            size = 40 if op.tier == "large" else (20 if op.tier == "medium" else 10)
            alpha = 0.9 if is_rogue else 0.35
            ax.scatter(op.lat_long[0], op.lat_long[1], color=color, s=size, edgecolor="black", linewidth=0.3, alpha=alpha, zorder=3)

        minx, miny, maxx, maxy = row["geometry"].bounds
        ax.set_xlim(minx - 0.2, maxx + 0.2)
        ax.set_ylim(miny - 0.2, maxy + 0.2)
         
        ax.set_title(f"Macro-Region: {reg_name.replace('_', ' ')}", fontsize=10, fontweight="bold")
        ax.set_axis_off()

    plt.suptitle("Figure 8. Regional Small-Multiples Contagion & Local Operator Interaction Maps", fontsize=11, fontweight="bold", y=0.96)
    plt.tight_layout(rect=[0, 0, 1, 0.94])
    plt.savefig("Regional_Contagion_Small_Multiples.png", dpi=300, bbox_inches="tight")
    plt.close()
    print("Regional small-multiples contagion grid successfully generated and saved.")

