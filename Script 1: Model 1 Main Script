class WasteComplianceEngine:
    """
    Macro-economic and regulatory physics engine enforcing true geographical boundaries 
    loaded from official QGIS shapefiles and dissolved into 4 macro operational regions.
    """

    def __init__(self, simulation_year=2015, external_shapefile_path=None):
        self.current_year = simulation_year
        self.ccs_master_records = ccs_master_records
        
        # 1. Geographic Map Regions (Macro administrative boundaries)
        self.regions = ["North", "Midlands", "South_West_Thames", "East_South_East"]

        target_shp = external_shapefile_path if external_shapefile_path else shapefile_path

        # Load official QGIS shapefile, map 7 sub-regions, and dissolve into 4 macro regions
        if target_shp and os.path.exists(target_shp):
            try:
                gdf_raw = gpd.read_file(target_shp)
                
                # Find the name column in the attribute table
                name_col = next((c for c in gdf_raw.columns if 'NM' in c or 'NAME' in c.upper()), gdf_raw.columns[0])
                
                def map_nhs_to_macro(nhs_name):
                    n = str(nhs_name).lower()
                    if any(x in n for x in ["north", "yorkshire"]):
                        return "North"
                    elif "midlands" in n:
                        return "Midlands"
                    elif "south west" in n:
                        return "South_West_Thames"
                    else:
                        return "East_South_East"

                gdf_raw["Region"] = gdf_raw[name_col].apply(map_nhs_to_macro)
                
                # Dissolve sub-regions into the 4 macro polygons
                self.ea_regions_gdf = gdf_raw.dissolve(by="Region").reset_index()
                print(f"Successfully dissolved official shapefile into your 4 macro-regions: {self.regions}")
            except Exception as e:
                print(f"Failed to load/dissolve shapefile ({e}). Falling back to programmatic geometry bounds.")
                target_shp = None

        if not target_shp or not os.path.exists(target_shp):
            self.region_geoms = {
                "North": Polygon([
                    (-3.2, 53.3), (-3.2, 55.9), (-1.2, 55.9), (-0.2, 54.2), 
                    (-0.8, 53.3)
                ]),
                "Midlands": Polygon([
                    (-3.0, 52.0), (-3.0, 53.3), (-0.8, 53.3), (0.4, 52.8), 
                    (0.4, 52.0), (-1.8, 51.3)
                ]),
                "East_South_East": Polygon([
                    (0.4, 50.7), (0.4, 52.8), (1.8, 52.8), (1.8, 51.0), 
                    (1.1, 50.5), (0.4, 50.7)
                ]),
                "South_West_Thames": Polygon([
                    (-5.7, 50.0), (-5.2, 51.3), (-3.0, 52.0), (-1.8, 51.3), 
                    (0.4, 50.7), (-0.8, 50.2)
                ])
            }
            gdf_records = [{"Region": r, "geometry": g} for r, g in self.region_geoms.items()]
            self.ea_regions_gdf = gpd.GeoDataFrame(gdf_records, crs="EPSG:4326")

        # Ensure correct CRS projection
        if self.ea_regions_gdf.crs is None:
            self.ea_regions_gdf.set_crs("EPSG:4326", inplace=True)
        else:
            self.ea_regions_gdf = self.ea_regions_gdf.to_crs("EPSG:4326")

        # Define centroids based on regional geometry using projected CRS to eliminate UserWarning
        projected_gdf = self.ea_regions_gdf.to_crs("EPSG:27700")
        self.region_coordinates = {
            row["Region"]: (row["geometry"].centroid.x, row["geometry"].centroid.y) 
            for _, row in projected_gdf.iterrows()
        }
         
        # Compute exact inter-regional distance matrix using exact region list keys to prevent lookup mismatches
        self.distance_matrix = {}
        for r1 in self.regions:
            self.distance_matrix[r1] = {}
            c1 = self.region_coordinates.get(r1, (0, 0))
            for r2 in self.regions:
                c2 = self.region_coordinates.get(r2, (0, 0))
                dist = math.sqrt((c1[0] - c2[0])**2 + (c1[1] - c2[1])**2)
                self.distance_matrix[r1][r2] = max(5.0, dist) # Minimum friction floor

