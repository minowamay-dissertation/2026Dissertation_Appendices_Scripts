def generate_figure_5_1_circular_chord(model):
    print("\nGenerating Figure 5.1: True Circular Chord Diagram...")
    regions = model.engine.regions
    aggregated_flows = {r: {dest: 0.0 for dest in regions} for r in regions}
    for rec in model.simulation_history:
        flows = rec.get("regional_waste_flows", {})
        for orig, targets in flows.items():
            for dest, tonnage in targets.items():
                aggregated_flows[orig][dest] += tonnage

    matrix = np.array([[aggregated_flows[orig][dest] for dest in regions] for orig in regions])
    row_sums = matrix.sum(axis=1)
    total_flow = row_sums.sum()
    if total_flow == 0:
        return

    fig, ax = plt.subplots(figsize=(9, 9))
    ax.set_aspect('equal')
    ax.axis('off')

    fig_colors = ['#1f77b4', '#ff7f0e', '#2ca02c', '#d62728']
    current_angle = 0.0
    arc_intervals = {}

    pad = 0.05
    net_angle = 2 * np.pi - pad * len(regions)

    for i, reg in enumerate(regions):
        fraction = row_sums[i] / total_flow
        angle_span = fraction * net_angle
        start_angle = current_angle
        end_angle = current_angle + angle_span
        arc_intervals[reg] = (start_angle, end_angle, fig_colors[i])
        current_angle = end_angle + pad

    r_outer = 1.0
    r_inner = 0.90

    for reg, (start, end, color) in arc_intervals.items():
        deg_start = np.degrees(start)
        deg_end = np.degrees(end)
        wedge = Wedge((0, 0), r_outer, deg_start, deg_end, width=(r_outer - r_inner), facecolor=color, edgecolor='black', linewidth=0.8)
        ax.add_patch(wedge)
         
        mid_angle = (start + end) / 2.0
        lx = 1.12 * np.cos(mid_angle)
        ly = 1.12 * np.sin(mid_angle)
        rot = np.degrees(mid_angle)
        if np.cos(mid_angle) < 0:
            rot += 180
        ax.text(lx, ly, reg.replace("_", " "), fontsize=10, fontweight='bold', ha='center', va='center', rotation=rot)

    source_offsets = {reg: arc_intervals[reg][0] for reg in regions}
    target_offsets = {reg: arc_intervals[reg][0] for reg in regions}

    for i, orig in enumerate(regions):
        for j, dest in enumerate(regions):
            val = matrix[i, j]
            if val <= 0 or orig == dest:
                continue
             
            fraction = val / total_flow
            span = fraction * net_angle

            s_start = source_offsets[orig]
            s_end = s_start + span
            source_offsets[orig] = s_end

            t_start = target_offsets[dest]
            t_end = t_start + span
            target_offsets[dest] = t_end

            s1_x, s1_y = r_inner * np.cos(s_start), r_inner * np.sin(s_start)
            s2_x, s2_y = r_inner * np.cos(s_end), r_inner * np.sin(s_end)
            t1_x, t1_y = r_inner * np.cos(t_start), r_inner * np.sin(t_start)
            t2_x, t2_y = r_inner * np.cos(t_end), r_inner * np.sin(t_end)

            ctrl_r = 0.3 * r_inner
            s_ctrl = ctrl_r * np.cos((s_start + s_end)/2.0), ctrl_r * np.sin((s_start + s_end)/2.0)
            t_ctrl = ctrl_r * np.cos((t_start + t_end)/2.0), ctrl_r * np.sin((t_start + t_end)/2.0)

            path_data = [
                (Path.MOVETO, (s1_x, s1_y)),
                (Path.CURVE4, s_ctrl),
                (Path.CURVE4, t_ctrl),
                (Path.CURVE4, (t1_x, t1_y)),
                (Path.LINETO, (t2_x, t2_y)),
                (Path.CURVE4, t_ctrl),
                (Path.CURVE4, s_ctrl),
                (Path.CURVE4, (s2_x, s2_y)),
                (Path.CLOSEPOLY, (s1_x, s1_y)),
            ]
            codes, verts = zip(*path_data)
            patch = PathPatch(Path(verts, codes), facecolor=fig_colors[i], edgecolor='none', alpha=0.55)
            ax.add_patch(patch)

    ax.set_xlim(-1.35, 1.35)
    ax.set_ylim(-1.35, 1.35)
    ax.set_title("Figure 5.1. Circular Chord Diagram of Inter-Regional Waste Flows", fontsize=13, fontweight='bold', pad=20)
    plt.tight_layout()
    plt.savefig("Figure5_1_Circular_Chord_Diagram.png", dpi=300, bbox_inches="tight")
    plt.close()
    print("True Circular Chord Diagram successfully generated and saved.")

