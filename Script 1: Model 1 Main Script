    # Rogue Small: Orange
    if rogue_small:
        ax.scatter([o.lat_long[0] for o in rogue_small], [o.lat_long[1] for o in rogue_small],
                   color="#ff7f0e", s=20, edgecolor="black", linewidth=0.4, alpha=0.85, zorder=4)

    # 5. Plot Unregulated Channels / Fly-Tipping Sinks (Black Crosses)
    unregulated_x, unregulated_y = [], []
    for op in (rogue_large + rogue_mid + rogue_small):
        if random.random() < 0.35:  # Generate leak paths for subset of rogue sites
            reg_geom = gdf[gdf["Region"] == op.region].geometry.iloc[0]
            leak_x = op.lat_long[0] + random.uniform(-0.12, 0.12)
            leak_y = op.lat_long[1] + random.uniform(-0.08, 0.08)
            if Point(leak_x, leak_y).within(reg_geom):
                unregulated_x.append(leak_x)
                unregulated_y.append(leak_y)
                ax.plot([op.lat_long[0], leak_x], [op.lat_long[1], leak_y],
                        color="#444444", linestyle=":", linewidth=0.5, alpha=0.4, zorder=2)

    if unregulated_x:
        ax.scatter(unregulated_x, unregulated_y, color="black", marker="x", s=25, linewidths=1.2, zorder=5)

    # 6. Plot EA Regional Hubs (Inspector Agents - Green Nodes)
    ea_hubs = {
        "North Hub (Leeds)": (-1.5491, 53.8008),
        "Midlands Hub (Birmingham)": (-1.8904, 52.4862),
        "South West Thames Hub (Bristol)": (-2.5879, 51.4545),
        "East South East Hub (London)": (-0.1278, 51.5074)
    }
    for hub_name, (hx, hy) in ea_hubs.items():
        ax.scatter(hx, hy, color="#2ca02c", marker="D", s=110, edgecolor="black", linewidth=1.0, zorder=6)
        ax.text(hx + 0.15, hy, hub_name, fontsize=8, fontweight="bold", color="#004d1a",
                bbox=dict(facecolor="white", alpha=0.85, edgecolor="#2ca02c", boxstyle="square,pad=0.2"), zorder=7)

    # 7. Map Limits & Layout Formatting
    ax.set_xlim(-6.2, 2.3)
    ax.set_ylim(49.8, 56.3)
    ax.set_aspect("equal")
    ax.set_axis_off()

    # 8. Custom Legend Matrix
    legend_elements = [
        Line2D([0], [0], marker='o', color='w', label='Rogue Operator (Large)', markerfacecolor='#8b0000', markeredgecolor='black', markersize=9),
        Line2D([0], [0], marker='o', color='w', label='Rogue Operator (Middle)', markerfacecolor='#ff0000', markeredgecolor='black', markersize=7),
        Line2D([0], [0], marker='o', color='w', label='Rogue Operator (Small)', markerfacecolor='#ff7f0e', markeredgecolor='black', markersize=5),
        Line2D([0], [0], marker='o', color='w', label='Compliant Operator (Blurred)', markerfacecolor='#1f77b4', alpha=0.4, markersize=6),
        Line2D([0], [0], marker='D', color='w', label='EA Regional Hub Inspector', markerfacecolor='#2ca02c', markeredgecolor='black', markersize=8),
        Line2D([0], [0], marker='x', color='black', label='Unregulated Channel / Fly-tipping Sink', linestyle='None', markersize=7, markeredgewidth=1.2),
    ]
    
    ax.legend(handles=legend_elements, loc="upper right", frameon=True, framealpha=0.95, fontsize=7.5, title="Agent & Channel Key", title_fontsize=8.5)
    
    ax.set_title("Figure 2. Visualisation of the Environment Agency’s jurisdictional region across England, its main environmental features, and its agents", fontsize=10, fontweight="bold", pad=12)
    
