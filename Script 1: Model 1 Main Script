def generate_figure_3b_enforcement_catch_ratio(model):
    print("\nGenerating Figure 3b: Enforcement Catch Ratio & Undetected Volume...")
    yearly_data = {}
    for rec in model.simulation_history:
        yr = rec["year"]
        if yr not in yearly_data:
            yearly_data[yr] = {"undetected_fraud_vol": 0.0}
        reg_illegal = rec.get("regional_illegal_waste", {})
        total_illegal = sum(reg_illegal.values())
        yearly_data[yr]["undetected_fraud_vol"] += total_illegal
         
    df_list = [{"Year": yr, "Undetected_Volume": vals["undetected_fraud_vol"] / 12.0} for yr, vals in yearly_data.items()]
    df = pd.DataFrame(df_list).groupby("Year").mean().reset_index()
    if df.empty:
        return

    fig, ax1 = plt.subplots(figsize=(10, 5))
    color = "#d62728"
    ax1.set_xlabel("Simulation Year", fontweight="bold")
    ax1.set_ylabel("Undetected / Illegal Waste Volume (Tonnes)", color=color, fontweight="bold")
    line1 = ax1.plot(df["Year"], df["Undetected_Volume"], color=color, linewidth=2.5, label="Undetected Fraud Volume")
    ax1.tick_params(axis='y', labelcolor=color)
    ax1.axvline(x=2026, color="black", linestyle="--", alpha=0.7, label="DWT Mandate (2026)")

    ax2 = ax1.twinx()  
    color = "#1f77b4"
