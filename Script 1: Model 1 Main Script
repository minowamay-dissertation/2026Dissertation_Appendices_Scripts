def resolve_macro_region(area_string):
    """
    Maps an incoming dataset operational area string to its true macro EA region.
    """
    if not isinstance(area_string, str):
        return "Midlands"
    cleaned = area_string.strip().lower()
    for macro_reg, areas in EA_OPERATIONAL_AREAS.items():
        for area in areas:
            if area.lower() in cleaned or cleaned in area.lower():
                return macro_reg
    return "Midlands"

