def generate_interactive_timeline_map(model):
    """
    Generates an interactive Plotly HTML map with a timeline slider (2015–2036) 
    showing agent positions, compliance bands, and red rims for rogue operators.
    """
    print("\nGenerating Interactive Longitudinal Agent Map with Time Slider...")
    
    yearly_snapshots = {}
    for rec in model.simulation_history:
        if rec.get("month", 12) == 12:
            yearly_snapshots[rec["year"]] = rec["agent_states"]
            
    sorted_years = sorted(list(yearly_snapshots.keys()))
    if not sorted_years:
        return

    band_colors = {
        "A": "#2ca02c",  # Pristine Green
        "B": "#17becf",  # Low Risk Cyan
        "C": "#1f77b4",  # Minor Breach Blue
        "D": "#ff7f0e",  # Moderate Breach Orange
        "E": "#d62728",  # Major Breach Red
        "F": "#8c564b"   # Insolvent Brown
    }

    frames = []
    initial_data = []
    
    first_yr = sorted_years[0]
    agents_first = yearly_snapshots[first_yr]
    
    lons_init = []
    lats_init = []
    colors_init = []
    border_colors_init = []
    border_widths_init = []
    hover_init = []
    
    agent_pos_map = {a.unique_id: a.lat_long for a in model.agents if isinstance(a, SpatialOperatorAgent) and a.lat_long}

    for a in agents_first:
        aid = a["id"]
        if aid in agent_pos_map and agent_pos_map[aid]:
            lon, lat = agent_pos_map[aid]
            lons_init.append(lon)
            lats_init.append(lat)
            
            rating = a.get("rating", "A")
            colors_init.append(band_colors.get(rating, "#1f77b4"))
            
            is_rogue = a.get("tax_arb", False) or a.get("treat_arb", False) or (a.get("true_compliance", 1.0) == 0.0)
