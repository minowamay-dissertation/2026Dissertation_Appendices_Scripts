def generate_figure_3c_transition_heatmap(model):
    print("\nGenerating Figure 3c: Markov State Transition Heatmap...")
    annual_states = {}
    for rec in model.simulation_history:
        if rec.get("month", 12) == 12:
            yr = rec["year"]
            if yr not in annual_states:
                annual_states[yr] = {}
            for a in rec["agent_states"]:
                annual_states[yr][a["id"]] = get_profile_name(a)

    states_list = [
        "Fully Compliant", 
        "Tax Arbitrage Only", 
        "Treatment Arbitrage Only", 
        "Multi-Mode Non-Compliant", 
        "Insolvent / Default"
    ]
    transition_counts = {s1: {s2: 0 for s2 in states_list} for s1 in states_list}

    sorted_years = sorted(list(annual_states.keys()))
    for i in range(len(sorted_years) - 1):
        yr_curr = sorted_years[i]
        yr_next = sorted_years[i+1]
        map_curr = annual_states[yr_curr]
        map_next = annual_states[yr_next]
         
        common_ids = set(map_curr.keys()).intersection(set(map_next.keys()))
        for aid in common_ids:
            s_from = map_curr[aid]
            s_to = map_next[aid]
            if s_from in transition_counts and s_to in transition_counts[s_from]:
                transition_counts[s_from][s_to] += 1

    df_trans = pd.DataFrame(transition_counts).T
    df_trans = df_trans.reindex(index=states_list, columns=states_list, fill_value=0)
    row_sums = df_trans.sum(axis=1)
    df_probs = df_trans.div(row_sums.replace(0, 1), axis=0)

    fig, ax = plt.subplots(figsize=(9, 7))
    sns.heatmap(df_probs, annot=True, fmt=".2f", cmap="Blues", cbar=True, ax=ax, linewidths=0.5, vmin=0, vmax=1)
    ax.set_title("Figure 3c. Markov Transition Probability Heatmap of Operator Profiles", fontweight="bold", pad=15)
    ax.set_xlabel("Target State (Year t+1)", fontweight="bold")
    ax.set_ylabel("Source State (Year t)", fontweight="bold")
    plt.xticks(rotation=30, ha='right')
    plt.yticks(rotation=0)
    plt.tight_layout()
    plt.savefig("Figure3c_Transition_Matrix_Heatmap.png", dpi=300, bbox_inches="tight")
    plt.close()
    print("Figure 3c successfully generated and saved.")

