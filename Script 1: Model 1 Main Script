    cum_means = df_mc["Final_Compliance_Rate"].expanding().mean()
    cum_stds = df_mc["Final_Compliance_Rate"].expanding().std(ddof=0)
    cv_series = cum_stds / cum_means
    for run_idx, cv_val in enumerate(cv_series):
